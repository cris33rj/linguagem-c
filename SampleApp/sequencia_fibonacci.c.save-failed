#include <stdio.h>


int main(void)
{
    printf("Informe quantos numero na sequencia");
    int quantNumeros;

    scanf("%d",&quantNumeros);

    int a[quantNumeros];
    int i = 0;


        a[0]=0;
        a[1]=1;

        for (i=3; i<quantNumeros; i++)
        {
            a[i] = a[i-2] + a[i-1];
            printf("%d",a[i]);

        }

        for (i=0; i<quantNumeros; i++)
        {
            printf("%d ",a[i]);

        }




}




